---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Cynex">
  <section class="container" style="padding-top: 96px; text-align: center;">
    <svg
      width="96" height="96" viewBox="0 0 96 96"
      xmlns="http://www.w3.org/2000/svg"
      role="img" aria-label="Cynex"
      style="display: block; margin: 0 auto 40px;"
    >
      <circle cx="48" cy="48" r="46" fill="#0A1F3F" stroke="#C8A94B" stroke-width="2"/>
      <circle cx="48" cy="48" r="38" fill="none" stroke="#C8A94B" stroke-width="1"/>
      <text
        x="48" y="60" text-anchor="middle"
        font-family="Urbanist, system-ui, sans-serif"
        font-size="36" font-weight="800"
        letter-spacing="2"
        fill="#C8A94B"
      >C</text>
    </svg>

    <div style="display: grid; gap: 24px; max-width: 560px; margin: 0 auto;">
      <a href="/catalog" class="card" style="text-decoration: none; text-align: left; padding: 28px 32px; display: block; border-left: 8px solid #B8312F;">
        <h2 style="margin: 0 0 6px; font-size: 20px;">Learn</h2>
        <p class="muted" style="margin: 0; font-size: 15px;">Browse the eLearning catalog and pick up where you left off.</p>
      </a>
      <a href="/login" class="card" style="text-decoration: none; text-align: left; padding: 28px 32px; display: block; border-left: 8px solid #0A1F3F;">
        <h2 style="margin: 0 0 6px; font-size: 20px;">Sign in</h2>
        <p class="muted" style="margin: 0; font-size: 15px;">Magic link to your email — no password needed.</p>
      </a>
    </div>
  </section>
</Layout>