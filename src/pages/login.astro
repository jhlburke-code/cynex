---
import Layout from '../layouts/Layout.astro';

const url = Astro.url;
const next = url.searchParams.get('next') ?? '/me';
const error = url.searchParams.get('error');
const sent = url.searchParams.get('sent');
---
<Layout title="Sign in">
  <section class="container" style="max-width: 480px;">
    <a href="/" class="muted" style="font-size: 14px;">← Home</a>
    <h1 style="margin-top: 16px;">Sign in</h1>
    <p class="muted">Enter your full name and work email — we'll send you a magic link.</p>

    <aside class="card" style="background: #F4F7FA; border-color: #1B3A6B; margin-top: 16px; padding: 16px 20px; font-size: 13px; line-height: 1.55; color: #0F2347;">
      <div style="font-weight: 700; color: #1B3A6B; margin-bottom: 8px; font-size: 14px;">Privacy & data on Cynex</div>
      <p style="margin: 0 0 8px;"><strong>Who runs it:</strong> John Burke, Karlsruhe (DE). Supervisory authority: LfDI BW.</p>
      <p style="margin: 0 0 8px;"><strong>What we collect:</strong> your name, email, IP, and your enrollments, completions, and certificates.</p>
      <p style="margin: 0 0 8px;"><strong>Why:</strong> to give you access to learning content and issue certificates. Lawful basis: your consent (Art. 6(1)(a) GDPR).</p>
      <p style="margin: 0 0 8px;"><strong>Who sees it:</strong> Cloudflare (hosting), Supabase (data), Resend (email), GitHub (widget code). All under EU SCCs + the EU-US Data Privacy Framework. Data may transit non-EU POPs.</p>
      <p style="margin: 0 0 8px;"><strong>How long:</strong> while your account is active + 24 months of inactivity, then anonymised.</p>
      <p style="margin: 0 0 8px;"><strong>Your rights:</strong> access, rectification, erasure, portability, restriction, objection, complaint to LfDI BW.</p>
      <p style="margin: 0;"><strong>No automated decisions.</strong> No tracking, no cookies that require consent.</p>
    </aside>

    {error && (
      <div class="card" style="background: var(--red-soft); border-color: var(--red); margin-top: 16px;">
        {error === 'invalid' && <p>We couldn't find that link. Try requesting a fresh one below.</p>}
        {error === 'name_required' && <p>Please enter your full name (at least 2 characters).</p>}
        {error === 'config' && <p>Auth isn't configured yet. Operator: set Supabase env vars on the deployment.</p>}
        {error !== 'invalid' && error !== 'config' && error !== 'name_required' && <p>Something went wrong ({error}). Try again.</p>}
      </div>
    )}

    {sent && (
      <div class="card" style="background: #E8F5E9; border-color: #1B5E20; margin-top: 16px;">
        <strong>Check your inbox.</strong>
        <p style="margin: 8px 0 0;">We sent a sign-in link to <strong>{sent}</strong>. It expires in 60 minutes.</p>
      </div>
    )}

    <form method="POST" action="/api/login" class="card" style="margin-top: 24px;">
      <label style="display: block; margin-bottom: 12px;">
        <div style="font-weight: 600; margin-bottom: 6px;">Full name</div>
        <input
          type="text"
          name="full_name"
          required
          minlength="2"
          maxlength="80"
          autocomplete="name"
          autofocus
          style="width: 100%; padding: 12px; border: 1px solid #D0D5DD; border-radius: 6px; font-size: 15px; font-family: inherit;"
          placeholder="John Burke"
        />
      </label>
      <label style="display: block; margin-bottom: 12px;">
        <div style="font-weight: 600; margin-bottom: 6px;">Work email</div>
        <input
          type="email"
          name="email"
          required
          style="width: 100%; padding: 12px; border: 1px solid #D0D5DD; border-radius: 6px; font-size: 15px; font-family: inherit;"
          placeholder="you@ionos.com"
        />
      </label>
      <input type="hidden" name="next" value={next} />
      <button type="submit" class="btn btn-primary" style="width: 100%;">Send magic link</button>
      <p class="muted" style="margin: 12px 0 0; font-size: 12px;">Your name appears on completion certificates and in the admin user list.</p>
    </form>
  </section>
</Layout>
