---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../lib/auth';
import { makeAuthenticatedClient } from '../../../lib/supabase';

const gate = await requireAdmin(Astro);
if (gate instanceof Response) return gate;

const { id } = Astro.params;
if (!id) return new Response('missing id', { status: 400 });

const client = makeAuthenticatedClient(Astro);

const { data: category, error } = await client
  .from('lms_categories')
  .select('*')
  .eq('id', id)
  .maybeSingle();

if (error || !category) return new Response('not found', { status: 404 });

// Eligible parents: other roots only (can't parent under yourself; can't parent under a child).
let rootsQuery = client
  .from('lms_categories')
  .select('id, slug, title')
  .is('parent_id', null)
  .neq('id', id)
  .order('display_order')
  .order('title');
const { data: roots } = await rootsQuery;

const { data: courseRows } = await client
  .from('lms_courses')
  .select('id, slug, title, is_published')
  .eq('category_id', id)
  .order('created_at', { ascending: false });

const url = Astro.url;
const errorMsg = url.searchParams.get('error');
const savedFlag = url.searchParams.get('saved') === '1';
---
<AdminLayout title={`Edit: ${category.title}`} active="categories">
  <a href="/admin/categories" class="muted" style="font-size: 14px;">← Categories</a>

  {errorMsg && (
    <div class="card" style="background: #FEE; border-color: #B71C1C; margin: 16px 0;">
      <strong>Save failed:</strong> {errorMsg}
    </div>
  )}
  {savedFlag && (
    <div class="card" style="background: #E8F5E9; border-color: #1B5E20; margin: 16px 0;">
      <strong>✓ Saved.</strong>
    </div>
  )}

  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-top: 16px;">
    <form method="POST" action={`/api/admin/categories/${category.id}`} class="card">
      <label style="display: block; margin-bottom: 16px;">
        <div style="font-weight: 600; margin-bottom: 6px;">Slug</div>
        <input type="text" name="slug" required value={category.slug}
          style="width: 100%; padding: 10px; border: 1px solid #D0D5DD; border-radius: 6px; font-family: ui-monospace, monospace; font-size: 14px;" />
      </label>

      <label style="display: block; margin-bottom: 16px;">
        <div style="font-weight: 600; margin-bottom: 6px;">Title</div>
        <input type="text" name="title" required value={category.title}
          style="width: 100%; padding: 10px; border: 1px solid #D0D5DD; border-radius: 6px; font-size: 15px;" />
      </label>

      <label style="display: block; margin-bottom: 16px;">
        <div style="font-weight: 600; margin-bottom: 6px;">Description</div>
        <textarea name="description" rows="2"
          style="width: 100%; padding: 10px; border: 1px solid #D0D5DD; border-radius: 6px; font-family: inherit; font-size: 14px;">{category.description ?? ''}</textarea>
      </label>

      <label style="display: block; margin-bottom: 16px;">
        <div style="font-weight: 600; margin-bottom: 6px;">Parent category</div>
        <select name="parent_id" style="width: 100%; padding: 10px; border: 1px solid #D0D5DD; border-radius: 6px; font-size: 15px;">
          <option value="" selected={category.parent_id === null}>— Root (no parent)</option>
          {(roots ?? []).map((r: any) => (
            <option value={r.id} selected={category.parent_id === r.id}>{r.title} (/{r.slug})</option>
          ))}
        </select>
      </label>

      <label style="display: block; margin-bottom: 24px;">
        <div style="font-weight: 600; margin-bottom: 6px;">Display order</div>
        <input type="number" name="display_order" value={category.display_order} min="0" max="999"
          style="width: 120px; padding: 10px; border: 1px solid #D0D5DD; border-radius: 6px; font-size: 15px;" />
      </label>

      <div style="display: flex; gap: 12px;">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href={`/catalog/categories/${category.slug}`} class="btn btn-secondary" target="_blank">View public →</a>
      </div>
    </form>

    <div>
      <div class="card" style="margin-bottom: 16px;">
        <h2 style="margin-top: 0; font-size: 16px;">Courses in this category</h2>
        {(!courseRows || courseRows.length === 0) ? (
          <p class="muted" style="margin: 0; font-size: 14px;">No courses assigned.</p>
        ) : (
          <ul style="margin: 0; padding-left: 18px;">
            {courseRows.map((c: any) => (
              <li style="margin-bottom: 4px; font-size: 14px;">
                <a href={`/admin/courses/${c.id}`}>{c.title}</a>
                {!c.is_published && <span class="muted" style="margin-left: 6px;">(draft)</span>}
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="card" style="border-color: #B71C1C;">
        <h2 style="margin-top: 0; font-size: 16px; color: #B71C1C;">Danger zone</h2>
        <form method="POST" action={`/api/admin/categories/${category.id}/delete`} onsubmit="return confirm('Delete this category? Courses will be uncategorized (not deleted).');">
          <button type="submit" class="btn btn-secondary" style="border-color: #B71C1C; color: #B71C1C;">Delete category</button>
        </form>
        <p class="muted" style="font-size: 12px; margin: 12px 0 0;">Courses keep their data; <code>category_id</code> is set to NULL.</p>
      </div>
    </div>
  </div>
</AdminLayout>